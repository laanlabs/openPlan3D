{
	"name": "open3dfloorplan",
	"private": true,
	"version": "0.9.0",
	"description": "Free open source 2D/3D floor plan editor — design in 2D, preview in 3D, all in your browser",
	"author": "theLodgeStudio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/theLodgeBots/open3dFloorplan.git"
	},
	"type": "module",
	"main": "build/index.js",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo 'svelte-kit sync did not finish. Type checks and unit tests need it: run npx svelte-kit sync.'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:browser": "playwright test",
		"test:watch": "svelte-kit sync && vitest",
		"benchmark:viewer": "playwright test --config=playwright.benchmark.config.ts",
		"benchmark:fixtures": "node tooling/render-fixtures.mjs",
		"catalog:manifest": "node tooling/catalog-manifest.mjs",
		"catalog:check": "node tooling/catalog-manifest.mjs --check",
		"audit:gate": "node tooling/audit-gate.mjs",
		"build:render-lab": "svelte-kit sync && vite build --config tooling/render-lab-site/vite.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "^6.0.6",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/three": "^0.182.0",
		"esbuild": "^0.28.2",
		"fake-indexeddb": "^6.2.5",
		"firebase": "^12.18.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"three": "^0.182.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"dxf-writer": "^1.18.4",
		"google-auth-library": "11.0.2",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.1",
		"svg-pathdata": "6.0.3",
		"three-gpu-pathtracer": "0.0.24",
		"three-mesh-bvh": "0.9.10"
	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.6"
	}
}
