{
	"name": "open3dfloorplan",
	"private": true,
	"version": "0.9.0",
	"description": "Free open source 2D/3D floor plan editor — design in 2D, preview in 3D, all in your browser",
	"author": "theLodgeStudio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/theLodgeBots/open3dFloorplan.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:watch": "vitest",
		"benchmark:viewer": "playwright test --config=playwright.benchmark.config.ts",
		"benchmark:fixtures": "node tooling/render-fixtures.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/three": "^0.182.0",
		"fake-indexeddb": "^6.2.5",
		"firebase": "^12.18.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"three": "^0.182.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"dxf-writer": "^1.18.4",
		"google-auth-library": "11.0.2",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.1",
		"three-gpu-pathtracer": "0.0.24",
		"three-mesh-bvh": "0.9.10"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	}
}
